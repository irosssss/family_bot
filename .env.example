# ==========================================
# Семейный бот — пример переменных окружения
# Скопируй этот файл в `.env` и заполни своими значениями.
#   cp .env.example .env
# `.env` в git НЕ попадает (см. .gitignore).
# ==========================================

# --- Сервер ---
NODE_ENV=development          # development | production
PORT=3000

# --- Telegram ---
# Основная переменная (её читает код в src/bot/telegramBot.ts):
BOT_TOKEN=123456:ABC-DEF...   # токен бота от @BotFather
# Алиас для docker-compose (заполни любое из двух — compose передаст в BOT_TOKEN):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001234567890  # id семейного чата для пуш-уведомлений
VITE_API_URL=http://localhost:3000  # публичный URL Mini App (для web_app кнопки)

# --- База данных (PostgreSQL) ---
# Основные переменные (их читает код в src/db/index.ts):
SQL_HOST=localhost           # в Docker: postgres
SQL_USER=app_user
SQL_PASSWORD=family_pass
SQL_DB_NAME=family_chores
# Для drizzle-kit (миграции):
SQL_ADMIN_USER=app_user
SQL_ADMIN_PASSWORD=family_pass
# Для docker-compose (postgres контейнер + app):
DB_PASSWORD=family_pass
DATABASE_URL=postgresql://app_user:***@localhost:5432/family_chores

# --- Cron ---
CRON_TIMEZONE=Europe/Moscow  # таймзона для ежедневных уведомлений

# --- Секрет вебхуков Telegram (обязателен в проде) ---
# Тот же секрет, что передаётся в setWebhook(secret_token=...).
# Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Без этого секрета Stars-начисления в production отклоняются (fail-closed).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=  # whitelist Telegram-ID через запятую (69513172); пусто = проверка выключена

# --- Sentry (необязательно; мониторинг ошибок) ---
SENTRY_DSN=

# --- S3-хранилище игровых ассетов (необязательно) ---
S3_REGION=us-east-1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=family-chores-assets
S3_PUBLIC_URL=
