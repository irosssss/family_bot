# ==========================================
# Семейный бот — пример переменных окружения
# Скопируй этот файл в `.env` и заполни своими значениями.
# `.env` в git НЕ попадает (см. .gitignore).
# ==========================================

# --- Сервер ---
NODE_ENV=development          # development | production
PORT=3000

# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF...   # токен бота от @BotFather
TELEGRAM_CHAT_ID=-1001234567890  # id семейного чата для пуш-уведомлений
VITE_API_URL=https://my-miniapp.example.com  # публичный URL Mini App (для web_app кнопки)

# --- База данных (PostgreSQL / Cloud SQL) ---
# SQL_HOST — либо обычный хост (localhost), либо путь к Unix-сокету Cloud SQL,
# например: /app/cloudsql/проект:регион:инстанс
SQL_USER=app_user
SQL_PASSWORD=твой_пароль_БД
SQL_DB_NAME=family_chores
SQL_HOST=localhost
SQL_ADMIN_USER=app_user         # для drizzle-kit (миграции)
SQL_ADMIN_PASSWORD=твой_пароль_БД

# --- Sentry (необязательно; мониторинг ошибок) ---
SENTRY_DSN=

# --- S3-хранилище игровых ассетов ---
S3_REGION=us-east-1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=твой_ключ_доступа
S3_SECRET_ACCESS_KEY=твой_секретный_ключ
S3_BUCKET_NAME=my-game-assets
S3_PUBLIC_URL=https://my-game-assets.storage.yandexcloud.net
