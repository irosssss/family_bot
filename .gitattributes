# Линейки: нормализуем LF в репозитории (рабочая копия на Windows не трогается)
* text=auto

# Исходники и конфиги — всегда LF в индексе
*.ts text
*.tsx text
*.js text
*.json text
*.md text
*.css text
*.html text
*.yml text
*.sql text
*.bat text eol=crlf
*.sh text eol=lf

# Бинарники — не трогаем и не диффим
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.mp3 binary
