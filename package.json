{
  "name": "family-chores",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:demo": "envskill run --only SQL_HOST,SQL_USER,SQL_PASSWORD,SQL_DB_NAME,SQL_ADMIN_USER,SQL_ADMIN_PASSWORD -- env DOTENV_CONFIG_PATH=/dev/null CRON_TIMEZONE=Europe/Moscow tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "db:push": "drizzle-kit push --config src/db/drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:verify-clean": "tsx scripts/verify-clean-migration.ts",
    "test": "vitest run",
    "unpack-local": "tsx scripts/unpack-local.ts",
    "lint": "tsc --noEmit",
    "target:typecheck": "tsc --noEmit -p tsconfig.target.json",
    "target:build": "esbuild scripts/target/dev.ts src/target/db/database.ts src/target/access/telegram/index.ts src/target/access/identityExchange.ts src/target/access/familySession.ts src/target/access/adultAccess.ts src/target/access/accessLifecycle.ts src/target/transport/http.ts src/target/content/input.ts src/target/content/compiler.ts scripts/target/content-validate.ts scripts/target/content-build.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outdir=work/target-build",
    "target:content:validate": "node --import tsx scripts/target/content-validate.ts",
    "target:content:build": "node --import tsx scripts/target/content-build.ts",
    "target:benchmark:pin": "node --import tsx scripts/target/benchmark-pin.ts",
    "target:test": "vitest run --config vitest.target.config.ts",
    "target:test:pg": "tsx scripts/target/test-environment.ts",
    "target:dev": "tsx scripts/target/dev.ts",
    "target:preview": "tsx scripts/target/preview.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.15",
    "adm-zip": "^0.6.0",
    "ajv": "8.20.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^174.0.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^1.2.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/adm-zip": "^0.5.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
